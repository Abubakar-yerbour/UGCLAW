# Auto-generated by pip/setuptools — never commit these
ugclaw.egg-info/
*.egg-info/
dist/
build/

# Python cache — regenerated automatically
__pycache__/
*.pyc
*.pyo

# Virtual environment — machine-specific
myenv/
venv/
.venv/
env/

# Runtime files — generated when daemon runs
*.pid
*.sock

# User data — private, machine-specific
/sec/

# Sensitive config — contains API keys and tokens
# (ship default_config.json as a template instead)
config.json
